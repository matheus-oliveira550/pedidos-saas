# Dependências (Pastas pesadas que são baixadas de novo com 'npm install')
node_modules/
jspm_packages/

# Builds e Logs de Produção (Arquivos gerados automaticamente)
dist/
build/
.next/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos Sensíveis (Chaves de API, senhas e variáveis de ambiente)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Arquivos do VS Code (Configurações locais que não devem ir para o time)
.vscode/
*.code-workspace
.history/

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
